@model IEnumerable<MyStore.Models.Product>
@{
    ViewBag.Title = "Quản lý sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var sort = ViewBag.Sort as string;
}

<h2>Quản lý sản phẩm</h2>
<a href="#" class="btn btn-success btn-sm mb-3">Thêm sản phẩm</a>

@using (Html.BeginForm("Index", "Products", new { area = "Admin" }, FormMethod.Get, new { @class = "row g-3 align-items-end" }))
{
    <div class="col-md-4">
        <label class="form-label">Từ khóa tìm kiếm</label>
        <input type="text" name="keyword" value="@ViewBag.Keyword" class="form-control"
               placeholder="Tên, mô tả hoặc danh mục sản phẩm" />
    </div>
    <div class="col-md-2">
        <label class="form-label">Giá thấp nhất</label>
        <input type="number" name="minPrice" value="@ViewBag.MinPrice" class="form-control" />
    </div>
    <div class="col-md-2">
        <label class="form-label">Giá cao nhất</label>
        <input type="number" name="maxPrice" value="@ViewBag.MaxPrice" class="form-control" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Sắp xếp</label>
        <select name="sort" class="form-select">
            <option value="name_asc" @(sort == "name_asc" ? "selected" : "")>Tên A - Z</option>
            <option value="name_desc" @(sort == "name_desc" ? "selected" : "")>Tên Z - A</option>
            <option value="price_asc" @(sort == "price_asc" ? "selected" : "")>Giá tăng dần</option>
            <option value="price_desc" @(sort == "price_desc" ? "selected" : "")>Giá giảm dần</option>
        </select>
    </div>
    <div class="col-md-1">
        <button type="submit" class="btn btn-primary">Tìm</button>
    </div>
}

<div class="my-3">
    @Html.ActionLink("Xóa bộ lọc", "Index", "Products", new { area = "Admin" }, new { @class = "btn btn-link text-light" })
</div>

<table class="table-admin">
    <thead>
        <tr>
            <th>Mã sản phẩm</th>
            <th>Tên sản phẩm</th>
            <th>Mô tả</th>
            <th>Giá</th>
            <th>Ảnh</th>
            <th>Danh mục</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr><td colspan="7" class="text-center">Không tìm thấy sản phẩm.</td></tr>
        }
        else
        {
            foreach (var p in Model)
            {
                <tr>
                    <td>@p.ProductID</td>
                    <td>@p.ProductName</td>
                    <td>@p.ProductDescription</td>
                    <td>@string.Format("{0:N0} đ", p.ProductPrice)</td>
                    <td>
                        @if (!string.IsNullOrEmpty(p.ProductImage))
                        {
                            <img src="~/Content/images/@p.ProductImage" height="50" alt="@p.ProductName" />
                        }
                    </td>
                    <td>@(p.Category != null ? p.Category.CategoryName : "")</td>
                    <td>
                        <a href="#" class="btn btn-sm btn-warning">Sửa</a>
                        <a href="#" class="btn btn-sm btn-danger">Xóa</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>