<!DOCTYPE html>
<html lang="vi" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - MyStore Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            background: #1b1d21;
            color: #e5e7eb;
            margin: 0;
        }

        .admin-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 8px;
        }

            .admin-header .brand {
                font-size: 18px;
            }

        .admin-wrap {
            display: flex;
            min-height: calc(100vh - 66px);
        }

        .admin-sidebar {
            width: 210px;
            background: #2b303b;
            padding: 20px 0;
            flex-shrink: 0;
        }

            .admin-sidebar a {
                display: block;
                padding: 10px 24px;
                color: #e5e7eb;
                text-decoration: none;
                font-size: 14px;
            }

                .admin-sidebar a:hover, .admin-sidebar a.active {
                    background: #3a4150;
                }

        .admin-content {
            flex: 1;
            padding: 24px;
        }

        .table-admin {
            border-collapse: collapse;
            width: 100%;
        }

            .table-admin th, .table-admin td {
                border: 1px solid #3a3f4b;
                padding: 8px;
                font-size: 14px;
            }

            .table-admin th {
                background: #23262c;
            }
    </style>
</head>
<body>
    <div class="admin-header">
        <span class="brand">MyStore Admin</span>
        <a href="#">Đăng xuất</a>
    </div>

    <div class="admin-wrap">
        <div class="admin-sidebar">
            @Html.ActionLink("Trang chủ", "Index", "Home", new { area = "" }, null)
            <a href="#">Danh mục</a>
            @Html.ActionLink("Sản phẩm", "Index", "Products", new { area = "Admin" }, new { @class = "active" })
            <a href="#">Khách hàng</a>
            <a href="#">Đơn hàng</a>
            <a href="#">Tài khoản Admin</a>
        </div>

        <div class="admin-content">
            @RenderBody()
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>